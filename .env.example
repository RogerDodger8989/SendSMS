# ---- SMS Proxy (feature/sms-proxy) ----

# Master 46elks credentials — used for ALL outgoing SMS via the proxy endpoint
ELKS_USERNAME=your_46elks_username
ELKS_PASSWORD=your_46elks_password

# FOSSBilling server — used to validate client license keys via the public guest API
# (no API key needed; uses GET /api/guest/service/license)
FOSSBILLING_URL=https://billing.yourdomain.com

# ---- General ----

# Override Flask secret key (auto-generated and stored in data/.secret_key if omitted)
# SECRET_KEY=change_this_to_a_random_string

# PIN override for emergency admin access
# MASTER_PIN=

# SQLite data directory (default: ./data)
# DB_DIR=./data
